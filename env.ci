# .env.ci
# CI environment defaults — secrets are injected via GitHub Secrets at runtime
# This file is safe to commit — it contains no real credentials

BASE_URL=
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
SHOPIFY_STORE_PASSWORD=

# CI-specific Playwright settings
PWDEBUG=0
HEADED=true
SLOW_MO=0
CI=true

DEFAULT_TIMEOUT=60000       # Higher on CI — slower machines
EXPECT_TIMEOUT=15000
ACTION_TIMEOUT=30000

TEST_ENV=staging