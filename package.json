{
  "name": "pw-agents-poc",
  "version": "1.0.0",
  "description": "AI-driven test automation framework using Playwright Native Test Agents",
  "main": "index.js",
  "author": "",
  "license": "ISC",
  "keywords": [
    "playwright",
    "test-automation",
    "ai-agents",
    "e2e",
    "shopify"
  ],
  "scripts": {
    "test": "playwright test",
    "test:ci": "playwright test --project=chromium",
    "test:setup": "playwright test --project=setup",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:headed": "cross-env HEADED=true playwright test",
    "test:debug": "cross-env PWDEBUG=1 playwright test",
    "test:trace": "playwright test --trace on",
    "report": "playwright show-report",
    "clean": "rm -rf playwright-report test-results playwright/.auth/user.json",
    "clean:auth": "echo '{\"cookies\":[],\"origins\":[]}' > playwright/.auth/user.json",
    "setup:api-tools": "npm install --prefix mcp-servers/openapi-tools",

    "allure:clean": "rimraf allure-results allure-report",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:open": "npx allure open allure-report",
    "test:allure": "npm run allure:clean && npm run test; npm run allure:generate && npm run allure:open",
    "test:ui": "npm run allure:clean && npx playwright test --project=chromium; npm run allure:generate && npm run allure:open",
    "test:api": "npm run allure:clean && npx playwright test --project=\"API RUN\"; npm run allure:generate && npm run allure:open"
  
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.3",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.0",
    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "rimraf": "^6.1.3"
  },
  "dependencies": {
    "node": "^26.3.1"
  }
}
